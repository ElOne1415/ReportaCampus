# ==========================================================
# Configuración del backend de ReportaCampus
# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube al repositorio.
# ==========================================================

# Clave para firmar los tokens de sesión. Usa una cadena larga y aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave

# Base de datos.
# Desarrollo (por defecto): SQLite en backend/instancia/reportacampus.db
DATABASE_URL=sqlite:///reportacampus.db
# SQL Server (requiere pip install -r requirements-sqlserver.txt y el ODBC Driver 18):
# DATABASE_URL=mssql+pyodbc://USUARIO:CONTRASENA@SERVIDOR:1433/ReportaCampus?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Horas que dura una sesión
JWT_HORAS=8

# Orígenes que pueden llamar a la API desde otro dominio (separados por coma)
CORS_ORIGENES=http://localhost:8080,http://127.0.0.1:8080,https://elone1415.github.io

# Cargar los datos de demostración si la base de datos está vacía
AUTO_SEMILLA=1

# Mostrar las cuentas de demostración en la página de inicio de sesión
MOSTRAR_CUENTAS_DEMO=1

# Puerto del servidor de desarrollo
PUERTO=5000
